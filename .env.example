# Copy to .env and fill in. Never commit .env.
# Defaults live in backend/app/config.py; empty values here mean "use the default".
DEV_MODE=
# In-process daily job for alerts and 3-month reviews (default on). 0 switches it off.
SCHEDULER_ENABLED=
DATABASE_URL=
# Required when DEV_MODE=0: at least 32 random characters, or login answers 503 (DEC-97).
JWT_SECRET=
# stub (default, no key, no network) | gemini | claude
LLM_PROVIDER=
LLM_API_KEY=
# empty = provider default (gemini-3.8-flash or claude-haiku-5-5); set to a model your key can use
LLM_MODEL=
# Gemini only: tried once when the main model is unavailable (DEC-81). empty = gemini-3.5-flash-lite, off = none
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_S=
LLM_MAX_RETRIES=
EMBED_MODEL=
OVERPASS_URL=
NOMINATIM_URL=
APP_USER_AGENT=
# mock (default, offline fixtures in data/osm_mock/) or live (real Overpass and Nominatim)
OSM_MODE=
# browser origins allowed by CORS, comma-separated (default: the Vite dev server on port 5173); * is ignored
CORS_ORIGINS=
# larger request bodies get 413 (default 65536)
MAX_BODY_BYTES=
